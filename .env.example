# Research Journal Finder AI - Environment Configuration
# Copy this file to .env and adjust variables as needed

# Contact email for OpenAlex & Crossref polite API pools (strongly recommended)
OPENALEX_EMAIL=researcher@example.com
CROSSREF_EMAIL=researcher@example.com

# LLM Provider: "fallback" (no API key needed, offline rules + heuristics),
# or "gemini", "openai", "ollama"
LLM_PROVIDER=fallback

# Optional API Keys (if using an LLM provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
